[Desktop Entry]
Type=Application
Name=Template App
Comment=A starting point for GTK 4 apps
Exec=tapp
Icon=io.github.DisposableSoftware.TemplateApp
StartupWMClass=io.github.DisposableSoftware.TemplateApp
Terminal=false
StartupNotify=true
Categories=GTK;Utility;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=tapp
