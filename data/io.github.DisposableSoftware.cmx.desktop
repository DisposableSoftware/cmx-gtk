[Desktop Entry]
Type=Application
Name=cmx
Comment=Read .cbz comics
Exec=cmx %F
Icon=io.github.DisposableSoftware.cmx
StartupWMClass=io.github.DisposableSoftware.cmx
Terminal=false
StartupNotify=true
MimeType=application/vnd.comicbook+zip;application/x-cbz;
Categories=Graphics;Viewer;
Keywords=comic;cbz;reader;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=cmx
