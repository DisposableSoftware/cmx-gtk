[Desktop Entry]
Type=Application
Name=cmx
Comment=A starting point for GTK 4 apps
Exec=cmx
Icon=io.github.DisposableSoftware.cmx
StartupWMClass=io.github.DisposableSoftware.cmx
Terminal=false
StartupNotify=true
Categories=GTK;Utility;
